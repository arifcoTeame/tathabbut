# Where build_index.py writes and the API reads the index
TATHABBUT_INDEX_DIR=../data/index
# Comma-separated frontend origins allowed by CORS
TATHABBUT_CORS=http://localhost:3000
# Max characters per /verify request
TATHABBUT_MAX_CHARS=4000
# Link template for verse sources
TATHABBUT_QURAN_LINK=https://tanzil.net/#{surah}:{ayah}
# true in production: any verdict resting on an unreviewed source becomes NEEDS_REVIEW
TATHABBUT_REQUIRE_VERIFIED=false
